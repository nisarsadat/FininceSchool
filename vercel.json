{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "env": {
        "APP_DEBUG": "true",
        "APP_ENV": "production",
        "APP_URL": "https://finince-school.vercel.app",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "ep-billowing-paper-b5sarjrc-pooler.c-7.us-east-2.aws.neon.tech",
        "DB_PORT": "5432",
        "DB_DATABASE": "neondb",
        "DB_USERNAME": "neondb_owner",
        "DB_SSLMODE": "require",
        "DB_ENDPOINT": "ep-billowing-paper-b5sarjrc",
        "SESSION_DRIVER": "database",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "database"
    },
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
